rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Custom helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isVerifiedStudent() {
      return isAuthenticated() && request.auth.token.email_verified == true 
             && request.auth.token.email.matches('.*\\.edu$');
    }
    
    // USERS
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId;
    }
    
    // PRODUCTS
    match /products/{productId} {
      allow read: if isAuthenticated();
      // Only verified students can sell, and they can only set themselves as the seller
      allow create: if isVerifiedStudent() && request.resource.data.sellerId == request.auth.uid;
      // Only the seller can update/delete their listings
      allow update, delete: if isVerifiedStudent() && resource.data.sellerId == request.auth.uid;
    }
    
    // CHAT (Conversations & Messages)
    match /conversations/{conversationId} {
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId;
      }
    }
    
    // REVIEWS
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isVerifiedStudent() && request.auth.uid == request.resource.data.reviewerId;
    }
  }
}
